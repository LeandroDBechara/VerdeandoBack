<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard de Estadisticas - Verdeando</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 45%, #40916c 100%);
      min-height: 100vh;
      padding: 24px 16px 32px;
      color: #1f2933;
    }

    .container {
      background: #f7faf8;
      border-radius: 24px;
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.18);
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      overflow: hidden;
    }

    .dashboard-header {
      background: linear-gradient(135deg, #081c15 0%, #1b4332 100%);
      padding: 28px 32px 24px;
      text-align: center;
      border-bottom: 3px solid #74c69d;
    }

    .brand-logo {
      display: block;
      width: min(280px, 72vw);
      height: auto;
      margin: 0 auto 14px;
      object-fit: contain;
    }

    .dashboard-subtitle {
      color: #b7e4c7;
      font-size: 0.98rem;
      line-height: 1.5;
      max-width: 560px;
      margin: 0 auto;
    }

    .dashboard-subtitle code {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(183, 228, 199, 0.35);
      border-radius: 6px;
      color: #d8f3dc;
      font-size: 0.88rem;
      padding: 2px 8px;
    }

    .dashboard-body {
      padding: 24px 32px 32px;
    }

    .toolbar {
      display: flex;
      justify-content: center;
      margin-bottom: 16px;
    }

    input,
    button {
      border: 2px solid #d8e2dc;
      border-radius: 10px;
      font-size: 0.95rem;
      padding: 12px 18px;
      transition: all 0.25s ease;
    }

    input {
      min-width: 280px;
      outline: none;
    }

    input:focus {
      border-color: #40916c;
      box-shadow: 0 0 0 3px rgba(64, 145, 108, 0.15);
    }

    button {
      background: linear-gradient(45deg, #40916c, #2d6a4f);
      color: white;
      cursor: pointer;
      font-weight: 600;
      border: none;
      min-width: 220px;
    }

    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(45, 106, 79, 0.35);
    }

    .status {
      background: #ffffff;
      border: 1px solid #d8e2dc;
      padding: 12px 16px;
      border-radius: 10px;
      margin-bottom: 22px;
      color: #52606d;
      text-align: center;
      font-size: 0.94rem;
    }

    .status.error {
      color: #b42318;
      border-color: #fecdca;
      background: #fef3f2;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 18px;
    }

    .card {
      background: #ffffff;
      border: 1px solid #e3ebe6;
      border-radius: 16px;
      box-shadow: 0 8px 18px rgba(27, 67, 50, 0.06);
      padding: 18px;
      animation: fadeIn 0.5s ease-in;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .card h2 {
      margin: 0 0 14px;
      font-size: 1rem;
      color: #1b4332;
      padding-bottom: 10px;
      border-bottom: 2px solid #d8f3dc;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.92rem;
    }

    th, td {
      text-align: left;
      padding: 8px 6px;
      border-bottom: 1px solid #edf2ed;
      vertical-align: top;
    }

    th {
      color: #52606d;
      font-weight: 700;
    }

    .top-stat {
      background: #edf7f0;
      border: 1px dashed #95d5b2;
      border-radius: 10px;
      padding: 10px;
      font-size: 0.92rem;
    }

    .bar-track {
      width: 100%;
      height: 10px;
      border-radius: 999px;
      background: #edf4ef;
      overflow: hidden;
      margin-top: 4px;
    }

    .bar {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #52b788, #2d6a4f);
    }

    .muted {
      color: #667085;
    }

    @media (max-width: 640px) {
      body {
        padding: 12px 10px 20px;
      }

      .dashboard-header {
        padding: 22px 18px 18px;
      }

      .dashboard-body {
        padding: 18px 16px 22px;
      }

      input {
        min-width: 0;
        width: 100%;
      }

      button {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <main class="container">
    <header class="dashboard-header">
      <img src="/logoVerdeando.png" alt="Verdeando" class="brand-logo" />
      <p class="dashboard-subtitle">
        Dashboard de Estadisticas y metricas de <code>/estadisticas</code>
      </p>
    </header>

    <div class="dashboard-body">
      <section class="toolbar">
        <button id="btnRefresh">Actualizar dashboard</button>
      </section>

      <div id="status" class="status">Cargando estadisticas...</div>

      <section class="grid">
        <article class="card">
          <h2>Usuarios con mas puntos</h2>
          <div id="usuariosPuntos"></div>
        </article>

        <article class="card">
          <h2>Usuarios que mas reciclaron (gramos)</h2>
          <div id="usuariosReciclaron"></div>
        </article>

        <article class="card">
          <h2>Usuarios con mas eventos participados</h2>
          <div id="usuariosEventos"></div>
        </article>

        <article class="card">
          <h2>Top recompensas mas canjeadas</h2>
          <div id="recompensas"></div>
        </article>

        <article class="card">
          <h2>Puntos verdes mas usados</h2>
          <div id="puntosVerdes"></div>
        </article>

        <article class="card">
          <h2>Eventos con mayor participacion</h2>
          <div id="eventos"></div>
        </article>

        <article class="card">
          <h2>Material mas reciclado (global)</h2>
          <div id="materialGlobal" class="top-stat muted">Sin datos.</div>
        </article>
      </section>
    </div>
  </main>

  <script>
    const API_BASE = "/estadisticas";

    const el = {
      status: document.getElementById("status"),
      usuariosPuntos: document.getElementById("usuariosPuntos"),
      usuariosReciclaron: document.getElementById("usuariosReciclaron"),
      usuariosEventos: document.getElementById("usuariosEventos"),
      recompensas: document.getElementById("recompensas"),
      puntosVerdes: document.getElementById("puntosVerdes"),
      eventos: document.getElementById("eventos"),
      materialGlobal: document.getElementById("materialGlobal")
    };

    async function request(path) {
      const headers = { "Content-Type": "application/json" };

      const res = await fetch(API_BASE + path, { headers });
      if (!res.ok) {
        const body = await res.text();
        throw new Error(path + " -> HTTP " + res.status + " " + body.slice(0, 120));
      }
      return res.json();
    }

    function renderTable(target, headers, rows) {
      if (!rows || rows.length === 0) {
        target.innerHTML = '<p class="muted">Sin datos.</p>';
        return;
      }
      const head = headers.map(function(h) { return "<th>" + h + "</th>"; }).join("");
      const body = rows.map(function(row) {
        const cols = row.map(function(col) { return "<td>" + col + "</td>"; }).join("");
        return "<tr>" + cols + "</tr>";
      }).join("");
      target.innerHTML = "<table><thead><tr>" + head + "</tr></thead><tbody>" + body + "</tbody></table>";
    }

    function numberFmt(value) {
      return new Intl.NumberFormat("es-AR").format(value || 0);
    }

    function renderBars(target, list, labelKey, valueKey, suffix) {
      if (!list || list.length === 0) {
        target.innerHTML = '<p class="muted">Sin datos.</p>';
        return;
      }
      const max = Math.max.apply(null, list.map(function(i) { return Number(i[valueKey]) || 0; }));
      target.innerHTML = list.map(function(item) {
        const value = Number(item[valueKey]) || 0;
        const width = max > 0 ? (value * 100) / max : 0;
        return "<div style='margin-bottom:8px;'><div><strong>" + item[labelKey] + "</strong> - " + numberFmt(value) + " " + suffix + "</div><div class='bar-track'><div class='bar' style='width:" + width + "%'></div></div></div>";
      }).join("");
    }

    function mapCountRows(list, labelKey, countPath) {
      return (list || []).map(function(i) {
        const count = i && i.valor ? i.valor : 0;
        return [i[labelKey], numberFmt(count)];
      });
    }

    function parseMaterialObject(raw) {
      if (!raw || typeof raw !== "object") return null;
      const nombre = raw.nombre || "Desconocido";
      const valor = raw.valor || 0;
      return { nombre, valor };
    }

    async function loadDashboard() {
      setStatus("Cargando estadisticas...");
      const failures = [];

      const endpoints = [
        ["/usuarios-mas-puntos", function(data) {
          renderBars(el.usuariosPuntos, data, "nombre", "valor", "pts");
        }],
        ["/usuarios-mas-reciclaron", function(data) {
          renderBars(el.usuariosReciclaron, data, "nombre", "valor", "g");
        }],
        ["/usuarios-mas-eventos-participaron", function(data) {
          renderBars(el.usuariosEventos, data, "nombre", "valor", "eventos");
        }],
        ["/recompensas-mas-canjeadas", function(data) {
          renderTable(el.recompensas, ["Recompensa", "Canjes"], mapCountRows(data, "nombre", "valor"));
        }],
        ["/puntos-verdes-mas-usados", function(data) {
          renderTable(el.puntosVerdes, ["Punto verde", "Usos"], mapCountRows(data, "nombre", "valor"));
        }],
        ["/eventos-mayor-participacion", function(data) {
          renderTable(el.eventos, ["Evento", "Participaciones"], mapCountRows(data, "nombre", "valor"));
        }],
        ["/material-mas-reciclado", function(data) {
          renderTable(el.materialGlobal, ["Material", "Gramos reciclados"], mapCountRows(data, "nombre", "valor"));
        }]
      ];

      await Promise.all(endpoints.map(async function(item) {
        const path = item[0];
        const render = item[1];
        try {
          const data = await request(path);
          render(data);
        } catch (error) {
          failures.push(error.message);
        }
      }));

      if (failures.length === 0) {
        setStatus("Dashboard actualizado correctamente.");
      } else {
        setStatus("Se cargaron datos parciales. Revisar errores: " + failures.join(" | "), true);
      }
    }

    function setStatus(msg, isError) {
      el.status.textContent = msg;
      el.status.className = isError ? "status error" : "status";
    }

    document.getElementById("btnRefresh").addEventListener("click", loadDashboard);

    document.addEventListener("DOMContentLoaded", function() {
      loadDashboard();
    });
  </script>
</body>
</html>
